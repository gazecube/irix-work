+/*
+ * Plane (layer) machinery.  A window belongs to the plane of its visual; the
+ * server clips windows against same-plane windows only (mi/mivaltree.c).
+ */
+static int
+xmfbWindowLayer(WindowPtr pWin)
+{
+    vfbScreenInfoPtr pvfb;
+    int l;
+
+    while (pWin && pWin->parent && pWin->drawable.class != InputOutput)
+        pWin = pWin->parent;
+    if (!pWin || !pWin->parent)
+        return XL_IMAGE;
+    pvfb = &vfbScreens[pWin->drawable.pScreen->myNum];
+    if (pWin->drawable.depth == 8)
+        for (l = 0; l < XL_COUNT; l++)
+            if (l != XL_IMAGE && pvfb->layerVid[l] == wVisual(pWin))
+                return l;
+    return XL_IMAGE;
+}
+
+static void
+xmfbPublishOverlayVisuals(WindowPtr root)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[root->drawable.pScreen->myNum];
+    CARD32 info[12];
+    int n = 0;
+    Atom a = MakeAtom("SERVER_OVERLAY_VISUALS", 22, TRUE);
+
+    /* {visual id, transparency type (1 = pixel), value, layer}: overlay 1, popup 2, underlay -1 */
+    info[n++] = pvfb->layerVid[XL_OVERLAY]; info[n++] = 1; info[n++] = 0; info[n++] = 1;
+    info[n++] = pvfb->layerVid[XL_POPUP];   info[n++] = 1; info[n++] = 0; info[n++] = 2;
+    info[n++] = pvfb->layerVid[XL_UNDER];   info[n++] = 0; info[n++] = 0; info[n++] = (CARD32) -1;
+    if (a != BAD_RESOURCE)
+        dixChangeWindowProperty(serverClient, root, a, a, 32, PropModeReplace,
+                                n, info, FALSE);
+}
+
+static Bool
+xmfbCreateWindow(WindowPtr pWin)
+{
+    Bool ok = fbCreateWindow(pWin);
+
+    if (ok && pWin->drawable.class == InputOutput) {
+        vfbScreenInfoPtr pvfb = &vfbScreens[pWin->drawable.pScreen->myNum];
+
+        if (pvfb->planePix[XL_IMAGE])
+            dixSetPrivate(&pWin->devPrivates, fbGetWinPrivateKey(pWin),
+                          pvfb->planePix[xmfbWindowLayer(pWin)]);
+        if (!pWin->parent)
+            xmfbPublishOverlayVisuals(pWin);
+    }
+    return ok;
+}
+
+static Bool
+xmfbCreateScreenResources(ScreenPtr pScreen)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[pScreen->myNum];
+    int l;
+
+    if (!miCreateScreenResources(pScreen))
+        return FALSE;
+    for (l = 0; l < XL_COUNT; l++) {
+        int depth = l == XL_IMAGE ? 24 : 8;
+        int bpp = l == XL_IMAGE ? 32 : 8;
+        void *bits = l == XL_IMAGE ? (void *) pvfb->img : (void *) pvfb->plane8[l];
+        int stride = l == XL_IMAGE ? pvfb->paddedWidth * 4 : pvfb->stride8;
+        PixmapPtr pix = (*pScreen->CreatePixmap) (pScreen, 0, 0, depth, 0);
+
+        if (!pix)
+            return FALSE;
+        if (!(*pScreen->ModifyPixmapHeader) (pix, pScreen->width, pScreen->height,
+                                             depth, bpp, stride, bits))
+            return FALSE;
+        pvfb->planePix[l] = pix;
+    }
+    pScreen->devPrivate = pvfb->planePix[XL_IMAGE];
+    return TRUE;
+}
+
+static Bool
+xmfbCloseScreenPlanes(ScreenPtr pScreen)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[pScreen->myNum];
+    int l;
+
+    for (l = 0; l < XL_COUNT; l++) {
+        if (pvfb->planePix[l])
+            (*pScreen->DestroyPixmap) (pvfb->planePix[l]);
+        pvfb->planePix[l] = NULL;
+    }
+    return TRUE;
+}
+
+/* pointer hit test: a higher plane wins over a lower one, then stacking order */
+static WindowPtr
+xmfbXYToWindow(ScreenPtr pScreen, SpritePtr pSprite, int x, int y)
+{
+    WindowPtr pWin, best;
+    BoxRec box;
+
+    pSprite->spriteTraceGood = 1;       /* root window still there */
+    pWin = pSprite->spriteTrace[pSprite->spriteTraceGood - 1]->firstChild;
+    while (pWin) {
+        best = NULL;
+        for (; pWin; pWin = pWin->nextSib) {
+            if (pWin->mapped &&
+                x >= pWin->drawable.x - wBorderWidth(pWin) &&
+                x < pWin->drawable.x + (int) pWin->drawable.width + wBorderWidth(pWin) &&
+                y >= pWin->drawable.y - wBorderWidth(pWin) &&
+                y < pWin->drawable.y + (int) pWin->drawable.height + wBorderWidth(pWin) &&
+                (!wBoundingShape(pWin) || PointInBorderSize(pWin, x, y)) &&
+                (!wInputShape(pWin) ||
+                 RegionContainsPoint(wInputShape(pWin), x - pWin->drawable.x,
+                                     y - pWin->drawable.y, &box)) &&
+                !pWin->unhittable) {
+                if (!best || xmfbWindowLayer(pWin) > xmfbWindowLayer(best))
+                    best = pWin;
+            }
+        }
+        if (!best)
+            break;
+        if (pSprite->spriteTraceGood >= pSprite->spriteTraceSize) {
+            pSprite->spriteTraceSize += 10;
+            pSprite->spriteTrace = reallocarray(pSprite->spriteTrace,
+                                                pSprite->spriteTraceSize,
+                                                sizeof(WindowPtr));
+        }
+        pSprite->spriteTrace[pSprite->spriteTraceGood++] = best;
+        pWin = best->firstChild;
+    }
+    return pSprite->spriteTrace[pSprite->spriteTraceGood - 1];
+}
