+/* which 8-bit plane does this colormap belong to, or -1 */
+static int
+xmfbMapLayer(ColormapPtr pmap)
+{
+    vfbScreenInfoPtr pvfb = &vfbScreens[pmap->pScreen->myNum];
+    int l;
+
