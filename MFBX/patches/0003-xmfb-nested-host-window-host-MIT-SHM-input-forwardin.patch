+/*
+ * Cursor: drawn last, above every plane, like a hardware sprite (the stock
+ * software cursor draws into the image plane, where an overlay window hides
+ * it).
+ */
+static struct {
+    CursorPtr cur;
+    int x, y;
+} xmfbSprite;
+
+static Bool
+xmfbRealizeCursor(DeviceIntPtr pDev, ScreenPtr pScreen, CursorPtr pCursor)
+{
+    return TRUE;
+}
+
+static Bool
+xmfbUnrealizeCursor(DeviceIntPtr pDev, ScreenPtr pScreen, CursorPtr pCursor)
+{
+    if (xmfbSprite.cur == pCursor)
+        xmfbSprite.cur = NULL;
+    return TRUE;
+}
+
+static void
+xmfbSetCursor(DeviceIntPtr pDev, ScreenPtr pScreen, CursorPtr pCursor, int x, int y)
+{
+    xmfbSprite.cur = pCursor;
+    xmfbSprite.x = x;
+    xmfbSprite.y = y;
+}
+
+static void
+xmfbMoveCursor(DeviceIntPtr pDev, ScreenPtr pScreen, int x, int y)
+{
+
+    xmfbSprite.x = x;
+    xmfbSprite.y = y;
+}
+
+static Bool
+xmfbDeviceCursorInitialize(DeviceIntPtr pDev, ScreenPtr pScreen)
+{
+    return TRUE;
+}
+
+static void
+xmfbDeviceCursorCleanup(DeviceIntPtr pDev, ScreenPtr pScreen)
+{
+}
+
+static miPointerSpriteFuncRec xmfbSpriteFuncs = {
+    xmfbRealizeCursor,
+    xmfbUnrealizeCursor,
+    xmfbSetCursor,
+    xmfbMoveCursor,
+    xmfbDeviceCursorInitialize,
+    xmfbDeviceCursorCleanup,
+};
+
+static void
+xmfbDrawCursor(vfbScreenInfoPtr pvfb)
+{
+    WindowPtr sw = inputInfo.pointer ? GetSpriteWindow(inputInfo.pointer) : NULL;
+    CursorPtr c = sw && !sw->cursorIsNone ? wCursor(sw) : NULL;
+    uint32_t *out = (uint32_t *) pvfb->pfbMemory;
+    int w, h, dx, dy;
+    uint32_t fg, bg;
+
+    }
+    if (!c || c == NullCursor || !c->bits || !inputInfo.pointer)
+        return;
+    GetSpritePosition(inputInfo.pointer, &xmfbSprite.x, &xmfbSprite.y);
+    }
+    w = c->bits->width;
+    h = c->bits->height;
+    fg = ((c->foreRed >> 8) << 16) | ((c->foreGreen >> 8) << 8) | (c->foreBlue >> 8);
+    bg = ((c->backRed >> 8) << 16) | ((c->backGreen >> 8) << 8) | (c->backBlue >> 8);
+    for (dy = 0; dy < h; dy++) {
+        int py = xmfbSprite.y - c->bits->yhot + dy;
+
+        if (py < 0 || py >= pvfb->height)
+            continue;
+        for (dx = 0; dx < w; dx++) {
+            int px = xmfbSprite.x - c->bits->xhot + dx;
+            uint32_t *dst;
+
+            if (px < 0 || px >= pvfb->width)
+                continue;
+            dst = &out[(size_t) py * pvfb->paddedWidth + px];
+            if (c->bits->argb) {
+                uint32_t a = c->bits->argb[dy * w + dx];
+                uint32_t al = a >> 24;
+
+                if (al == 255) {
+                    *dst = a & 0xffffff;
+                }
+                else if (al) {
+                    uint32_t d = *dst;
+                    uint32_t r = ((a >> 16) & 0xff) + ((d >> 16) & 0xff) * (255 - al) / 255;
+                    uint32_t g = ((a >> 8) & 0xff) + ((d >> 8) & 0xff) * (255 - al) / 255;
+                    uint32_t b = (a & 0xff) + (d & 0xff) * (255 - al) / 255;
+
+                    *dst = (r > 255 ? 255 : r) << 16 | (g > 255 ? 255 : g) << 8 | (b > 255 ? 255 : b);
+                }
+            }
+            else {
+                int stride = BitmapBytePad(w);
+                int bit = dx & 7;
+                const unsigned char *m = c->bits->mask + dy * stride + (dx >> 3);
+                const unsigned char *sbits = c->bits->source + dy * stride + (dx >> 3);
+
+                if ((*m >> bit) & 1)
+                    *dst = ((*sbits >> bit) & 1) ? fg : bg;
+            }
+        }
+    }
+}
+
 /*
  * Chroma-key composite of the planes into the visible framebuffer: an overlay
  * pixel other than index 0 wins, otherwise the image plane shows through.
@@ -541,11 +693,14 @@ xmfbComposite(vfbScreenInfoPtr pvfb)
 
         out[i] = o ? pvfb->ovlRGB[o] : pvfb->img[i];
