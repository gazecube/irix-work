+
+        if (!handlers) {
+            handlers = TRUE;
+            RegisterBlockAndWakeupHandlers(xmfbBlockHandler, xmfbWakeupHandler, NULL);
+        }
+    }
+#ifdef HAS_SHM
+    if (xmfbHostDisplay && pScreen->myNum == 0) {
+        xmfbHostActive = xmfbHostOpen(xmfbHostDisplay, pvfb->width, pvfb->height,
+                                      pvfb->shmid,
+                                      (size_t) (pvfb->pfbMemory - (char *) pvfb->pXWDHeader),
+                                      xmfbHostTitle, xmfbHostOverride,
+                                      xmfbHostX, xmfbHostY);
+        if (!xmfbHostActive)
+            return FALSE;
+    }
+#endif
+
     return ret;
 
 }                               /* end vfbScreenInit */
diff --git a/hw/xmfb/hostwin.c b/hw/xmfb/hostwin.c
new file mode 100644
index 0000000..654bb4e
--- /dev/null
+++ b/hw/xmfb/hostwin.c
@@ -0,0 +1,244 @@
+/*
+ * MFBX: nested-window output for Xmfb.  The composited framebuffer lives in
+ * SysV shared memory; a host X window shows it through MIT-SHM, and host
+ * keyboard and pointer events are queued into the server's input devices.
+ */
+
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include <xcb/xcb.h>
+#include <xcb/shm.h>
+#include <xcb/xproto.h>
+
+#include "os.h"
+#include "inputstr.h"
+#include "eventstr.h"
+#include "exevents.h"
+#include "xmfb.h"
+
+static xcb_connection_t *conn;
+static xcb_window_t win;
+static xcb_gcontext_t gc;
+static xcb_shm_seg_t seg;
+static int fb_w, fb_h;
+static uint32_t shm_offset;
+static DeviceIntPtr ptr_dev, kbd_dev;
+static xcb_atom_t wm_delete;
+
+void
+xmfbHostSetDevices(DeviceIntPtr p, DeviceIntPtr k)
+{
+    ptr_dev = p;
+    kbd_dev = k;
+}
+
+static xcb_atom_t
+intern(const char *name)
+{
+    xcb_intern_atom_reply_t *r =
+        xcb_intern_atom_reply(conn, xcb_intern_atom(conn, 0, strlen(name), name), NULL);
+    xcb_atom_t a = r ? r->atom : XCB_ATOM_NONE;
+
+    free(r);
+    return a;
+}
+
+static void
+queue_motion(int x, int y)
+{
+    ValuatorMask *mask;
+
+    if (!ptr_dev)
+        return;
+    mask = valuator_mask_new(2);
+    valuator_mask_set(mask, 0, x);
+    valuator_mask_set(mask, 1, y);
+    QueuePointerEvents(ptr_dev, MotionNotify, 0, POINTER_ABSOLUTE, mask);
+    valuator_mask_free(&mask);
+}
+
+static void
+queue_button(int type, int button)
+{
+    ValuatorMask *mask;
+
+    if (!ptr_dev)
+        return;
+    mask = valuator_mask_new(2);
+    QueuePointerEvents(ptr_dev, type, button, 0, mask);
+    valuator_mask_free(&mask);
+}
+
+static void
+host_events(int fd, int ready, void *data)
+{
+    xcb_generic_event_t *ev;
+
+    (void) fd; (void) ready; (void) data;
+    while ((ev = xcb_poll_for_event(conn))) {
+        if (ev->response_type == 0) {
+            xcb_generic_error_t *er = (xcb_generic_error_t *) ev;
+
+            ErrorF("Xmfb: host X error code %d major %d minor %d\n", er->error_code,
+                   er->major_code, er->minor_code);
+            free(ev);
+            continue;
+        }
+        switch (ev->response_type & 0x7f) {
+        case XCB_KEY_PRESS:
+        case XCB_KEY_RELEASE: {
+            xcb_key_press_event_t *k = (xcb_key_press_event_t *) ev;
+
+            if (kbd_dev)
+                QueueKeyboardEvents(kbd_dev,
+                                    (ev->response_type & 0x7f) == XCB_KEY_PRESS ?
+                                    KeyPress : KeyRelease, k->detail);
+            break;
+        }
+        case XCB_BUTTON_PRESS:
+        case XCB_BUTTON_RELEASE: {
+            xcb_button_press_event_t *b = (xcb_button_press_event_t *) ev;
+
+            queue_motion(b->event_x, b->event_y);
+            queue_button((ev->response_type & 0x7f) == XCB_BUTTON_PRESS ?
+                         ButtonPress : ButtonRelease, b->detail);
+            break;
+        }
+        case XCB_MOTION_NOTIFY: {
+            xcb_motion_notify_event_t *m = (xcb_motion_notify_event_t *) ev;
+
+            queue_motion(m->event_x, m->event_y);
+            break;
+        }
+        case XCB_ENTER_NOTIFY: {
+            xcb_enter_notify_event_t *e = (xcb_enter_notify_event_t *) ev;
+
+            queue_motion(e->event_x, e->event_y);
+            break;
+        }
+        case XCB_EXPOSE:
+            xmfbHostPresent();
+            break;
+        case XCB_CLIENT_MESSAGE: {
+            xcb_client_message_event_t *c = (xcb_client_message_event_t *) ev;
+
+            if (c->data.data32[0] == wm_delete)
+                kill(getpid(), SIGTERM);
+            break;
+        }
+        default:
+            break;
+        }
+        free(ev);
+    }
+    if (xcb_connection_has_error(conn))
+        kill(getpid(), SIGTERM);
+}
+
+Bool
+xmfbHostOpen(const char *display, int w, int h, int shmid, size_t offset,
+             const char *title, Bool override, int x, int y)
+{
+    xcb_screen_t *screen;
+    uint32_t values[3];
+    uint32_t mask = XCB_CW_BACK_PIXEL | XCB_CW_EVENT_MASK | XCB_CW_CURSOR;
+    xcb_pixmap_t blank;
+    xcb_cursor_t cursor;
+    int scr = 0;
+
+    conn = xcb_connect(display, &scr);
+    if (!conn || xcb_connection_has_error(conn)) {
+        ErrorF("Xmfb: cannot open host display %s\n", display ? display : "(default)");
+        return FALSE;
+    }
+    {
+        const xcb_setup_t *setup = xcb_get_setup(conn);
+        xcb_screen_iterator_t it = xcb_setup_roots_iterator(setup);
+
+        for (; it.rem && scr > 0; --scr)
+            xcb_screen_next(&it);
+        screen = it.data;
+    }
+
+    blank = xcb_generate_id(conn);
+    xcb_create_pixmap(conn, 1, blank, screen->root, 1, 1);
+    cursor = xcb_generate_id(conn);
+    xcb_create_cursor(conn, cursor, blank, blank, 0, 0, 0, 0, 0, 0, 0, 0);
+
+    win = xcb_generate_id(conn);
+    values[0] = screen->black_pixel;
+    values[1] = XCB_EVENT_MASK_KEY_PRESS | XCB_EVENT_MASK_KEY_RELEASE |
+                XCB_EVENT_MASK_BUTTON_PRESS | XCB_EVENT_MASK_BUTTON_RELEASE |
+                XCB_EVENT_MASK_POINTER_MOTION | XCB_EVENT_MASK_ENTER_WINDOW |
+                XCB_EVENT_MASK_EXPOSURE;
+    values[2] = cursor;
+    if (override) {
+        mask |= XCB_CW_OVERRIDE_REDIRECT;
+        /* values must be in mask-bit order: back pixel, override, events, cursor */
+        values[0] = screen->black_pixel;
+        {
+            uint32_t v[4] = { screen->black_pixel, 1, values[1], cursor };
+
+            xcb_create_window(conn, XCB_COPY_FROM_PARENT, win, screen->root, x, y,
+                              w, h, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT,
+                              screen->root_visual, mask, v);
+        }
+    }
+    else {
+        xcb_create_window(conn, XCB_COPY_FROM_PARENT, win, screen->root, x, y,
+                          w, h, 0, XCB_WINDOW_CLASS_INPUT_OUTPUT,
+                          screen->root_visual, mask, values);
+        xcb_change_property(conn, XCB_PROP_MODE_REPLACE, win, XCB_ATOM_WM_NAME,
+                            XCB_ATOM_STRING, 8, strlen(title), title);
+        wm_delete = intern("WM_DELETE_WINDOW");
+        {
+            xcb_atom_t protocols = intern("WM_PROTOCOLS");
+
+            xcb_change_property(conn, XCB_PROP_MODE_REPLACE, win, protocols,
+                                XCB_ATOM_ATOM, 32, 1, &wm_delete);
+        }
+        {
+            /* fixed size: min == max */
+            uint32_t hints[18] = { 0 };
+
+            hints[0] = (1 << 4) | (1 << 5);     /* PMinSize | PMaxSize */
+            hints[5] = w; hints[6] = h;         /* min */
+            hints[7] = w; hints[8] = h;         /* max */
+            xcb_change_property(conn, XCB_PROP_MODE_REPLACE, win,
+                                XCB_ATOM_WM_NORMAL_HINTS, XCB_ATOM_WM_SIZE_HINTS,
+                                32, 18, hints);
+        }
+    }
+
+    gc = xcb_generate_id(conn);
+    xcb_create_gc(conn, gc, win, 0, NULL);
+
+    seg = xcb_generate_id(conn);
+    xcb_shm_attach(conn, seg, shmid, 1);
+    fb_w = w;
+    fb_h = h;
+    shm_offset = (uint32_t) offset;
+
+    xcb_map_window(conn, win);
+    xcb_flush(conn);
+
+    SetNotifyFd(xcb_get_file_descriptor(conn), host_events, X_NOTIFY_READ, NULL);
+    return TRUE;
+}
+
+void
+xmfbHostPresent(void)
+{
+    if (!conn)
+        return;
+    xcb_shm_put_image(conn, win, gc, fb_w, fb_h, 0, 0, fb_w, fb_h, 0, 0, 24,
+                      XCB_IMAGE_FORMAT_Z_PIXMAP, 0, seg, shm_offset);
+    xcb_flush(conn);
+}
