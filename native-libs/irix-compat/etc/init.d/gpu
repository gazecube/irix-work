#!/bin/sh
# Load the GPU drivers just before the graphical login (S98xdm).  The Gentoo
# root keeps radeon/nouveau out of early boot (modprobe blacklist) so the
# Command Monitor textport stays on screen until graphics start, like IRIX.
case "$1" in
  'start')
	/usr/local/sbin/irix-gpu-load
	;;
  'stop')
	;;
  *)
	echo "usage: /etc/init.d/gpu {start|stop}"
	;;
esac
