#!/bin/sh
set -u

default_root="@IRIX_RECOMP_ROOT@"
runtime="@IRIX_RUNTIME_TREE@"
default_guest_runner="@CMAKE_CURRENT_BINARY_DIR@/irix-guest-exec"
# Installed prefix layout (desktop-integration/install-irix.sh):
#   <prefix>/bin/irix-session  <prefix>/root  <prefix>/tree  <prefix>/lib
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
prefix="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)"
if [ -d "$prefix/root" ] && [ -d "$prefix/tree" ]; then
    default_root="$prefix/root"
    runtime="$prefix/tree"
    default_guest_runner="$prefix/bin/irix-guest-exec"
    LD_LIBRARY_PATH="$prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LD_LIBRARY_PATH
fi
root="${IRIX_RECOMP_ROOT:-$default_root}"
IRIX_RUNTIME_TREE="${IRIX_RUNTIME_TREE:-$runtime}"
export IRIX_RUNTIME_TREE
runtime="$IRIX_RUNTIME_TREE"
display="${DISPLAY:-:1}"

makeicons="/usr/lib/desktop/makeIconVisuals"
prealloc="/usr/lib/desktop/preallocColors"
wm="/usr/bin/X11/4Dwm"
waitwm="/usr/bin/X11/wait4wm"
toolchest="/usr/bin/X11/toolchest"
fm="/usr/sbin/fm"
guest_runner="${IRIX_GUEST_EXEC_RUNNER:-$default_guest_runner}"

if [ ! -x "$guest_runner" ]; then
    echo "IRIX session: missing guest process runner: $guest_runner" >&2
    exit 1
fi
for p in "$makeicons" "$prealloc" "$wm" "$waitwm" "$toolchest" "$fm"; do
    if [ ! -r "$runtime$p" ]; then
        echo "IRIX session: missing guest image: $p" >&2
        exit 1
    fi
done
for guest_path in "$makeicons" "$prealloc" "$wm" "$waitwm" "$toolchest" "$fm"; do
    runner="$root$guest_path"
    if [ ! -x "$runner" ]; then
        echo "IRIX session: missing native x86-64 app runner: $runner" >&2
        exit 1
    fi
done

export DISPLAY="$display"
export IRIX_RECOMP_ROOT="$root"
export IRIX_GUEST_EXEC_RUNNER="$guest_runner"

# --- Per-user desktop state, as /var/X11/xdm/Xsession.dt sets it up -------
# IRIX keeps everything the desktop saves (4DWm background, Desktop prefs,
# window session, ...) under ~/.desktop-<host>, and finds the resource files
# there through XUSERFILESEARCHPATH.  Use the same search path so saved
# preferences are loaded at login.
desktop_host="$(uname -n 2>/dev/null)"
dotdesktop=".desktop-$desktop_host"
desktop_dir="$HOME/$dotdesktop"
XUSERFILESEARCHPATH="$desktop_dir/%N:$HOME/%N:$desktop_dir/0.0/%N"
export XUSERFILESEARCHPATH

# IRIX always runs on display :0.0, so the window-manager session lives in
# <desktop_dir>/0.0.  Here the display number varies by login, which sent each
# login to a different, empty directory.  Make every display name used for
# this session resolve to the one canonical "0.0" directory.
# (makeDotDesktop creates the directory on IRIX's first login.)
mkdir -p "$desktop_dir" 2>/dev/null
if [ -d "$desktop_dir" ]; then
    canon="$desktop_dir/0.0"
    disp_name=$(printf '%s' "$display" | sed 's/^[^:]*://')   # ":1" -> "1"
    for alias_name in "$disp_name" "${disp_name%.*}"; do
        [ -n "$alias_name" ] && [ "$alias_name" != "0.0" ] || continue
        alias_path="$desktop_dir/$alias_name"
        [ -L "$alias_path" ] && continue
        if [ -d "$alias_path" ]; then
            if [ ! -e "$canon" ]; then
                mv "$alias_path" "$canon"
            elif [ -s "$alias_path/4Dwmsession" ] && [ ! -s "$canon/4Dwmsession" ]; then
                mv "$canon" "$canon.old.$$" && mv "$alias_path" "$canon"
            else
                mv "$alias_path" "$alias_path.old.$$"
            fi
        fi
        [ -e "$canon" ] || mkdir -p "$canon"
        ln -s 0.0 "$alias_path" 2>/dev/null
    done
fi

# Variables set by the customization panels (launch effect, language ...).
[ -r "$desktop_dir/desktopenv" ] && . "$desktop_dir/desktopenv"
# Keep session startup on the validated Xt/Motif path.  The runtime's legacy
# stability fallback defaults on, but it broadly repairs missing Xt/Xm state
# and can hide regressions; callers may still opt in explicitly.
export IRIX_XT_XM_STABILITY="${IRIX_XT_XM_STABILITY:-0}"
# Select the standard Unix-domain X transport inside original SGI libX11.
# DISPLAY remains the user's :N display on the host; only the guest process
# sees unix/:N, avoiding IRIX's /dev/xconnc shared-memory transport device.
case "$display" in
    :*) export IRIX_GUEST_DISPLAY="unix/$display" ;;
esac
guest_exec()
{
    guest_path=$1
    shift
    runner="$root$guest_path"
    "$runner" "$@"
}

# "irix-session --end [-f]" is what the Toolchest Log Out entry runs.  The
# stock entry executes the guest endsession shell script through the generic
# runner, which depends on the guest /bin/sh and on xconfirm (SGI tu toolkit).
# Do the equivalent natively: confirm, ask 4Dwm to end the session, then tell
# the running session script (pidfile + SIGUSR1) to shut everything down.
pidfile="${XDG_RUNTIME_DIR:-/tmp}/irix-session-$(printf '%s' "$display" | tr -c 'A-Za-z0-9' _).pid"
if [ "${1:-}" = "--end" ]; then
    if [ "${2:-}" != "-f" ]; then
        # Prefer the IRIX xconfirm dialog; if it cannot run fall back to a
        # plain Xlib dialog so a stray click can never end the session.
        reply=$(guest_exec /usr/bin/X11/xconfirm -display "$display" \
            -header Confirm -icon question -B No -b Yes \
            -t "Do you want to log out now?" 2>/dev/null)
        rc=$?
        if [ "$rc" -lt 126 ]; then
            # xconfirm ran; an empty reply means it was dismissed.
            # xconfirm prints the pressed button's label on stdout.
            [ "$rc" -eq 0 ] && printf '%s\n' "$reply" | grep -qx Yes || exit 1
        elif command -v xmessage >/dev/null 2>&1; then
            xmessage -display "$display" -center -default No \
                -buttons No:1,Yes:0 "Do you want to log out now?" || exit 1
        else
            echo "IRIX session: no confirmation dialog available; use --end -f" >&2
            exit 1
        fi
    fi
    guest_exec /usr/bin/X11/tellwm end_session >/dev/null 2>&1
    sleep 1
    if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        kill -USR1 "$(cat "$pidfile")"
    else
        pkill -u "$(id -u)" -f "$root$wm" 2>/dev/null
    fi
    exit 0
fi
IRIX_SESSION_SCRIPT="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
export IRIX_SESSION_SCRIPT

cleanup()
{
    [ -n "${fm_pid:-}" ] && kill "$fm_pid" 2>/dev/null || true
    [ -n "${toolchest_pid:-}" ] && kill "$toolchest_pid" 2>/dev/null || true
    [ -n "${wm_pid:-}" ] && kill "$wm_pid" 2>/dev/null || true
}
echo $$ > "$pidfile"
trap 'rm -f "$pidfile"; cleanup' EXIT
trap 'exit 0' INT TERM USR1

echo "IRIX session: preparing icon visuals"
guest_exec "$makeicons" || {
    status=$?
    echo "IRIX session: makeIconVisuals failed: $status" >&2
    exit "$status"
}

echo "IRIX session: preallocating colors"
guest_exec "$prealloc" || {
    status=$?
    echo "IRIX session: preallocColors failed: $status" >&2
    exit "$status"
}

echo "IRIX session: starting 4Dwm on $DISPLAY"
# SG_UseBackgrounds makes 4Dwm run bgInit, which publishes the
# _SGI_DESKS_BACKGROUND_DAEMON_WINDOW<root> selection used by the
# Background panel and xsetroot.
# The stock IRIX app-defaults ship *freezeOnConfig: false, which makes 4Dwm
# draw move/resize outlines with FlashOutline (draw, sync, erase, sync in a
# loop), so the outline blinks.  True grabs the server and uses the steady
# DrawOutline instead.  Set IRIX_4DWM_FREEZE_ON_CONFIG=false for the original
# blinking behaviour.
freeze_on_config="${IRIX_4DWM_FREEZE_ON_CONFIG:-true}"
# On a traditional multihead server (:0.0, :0.1) 4Dwm can manage every screen
# with -multiscreen, as Mwm does.  Opt-in with IRIX_4DWM_MULTISCREEN=1: it
# currently traps in XtScreenDatabase/XrmEnumerateDatabase for screen 1.
multiscreen=
[ "${IRIX_4DWM_MULTISCREEN:-0}" = 1 ] && multiscreen=-multiscreen
# On a multi-screen server Xt builds each non-default screen database from
# that root's RESOURCE_MANAGER only, so the -xrm values below never reach
# 4Dwm's lookups (no granite background, blinking outlines).  Publish them on
# every screen root as well.
if command -v xrdb >/dev/null 2>&1; then
    xdisp="${DISPLAY%.*}"
    xscr=0
    while [ "$xscr" -lt 8 ]; do
        # What Xsession.dt does: ~/.Xresources replaces the database, else
        # ~/.Sgiresources (saved Desktop preferences) is merged.
        if [ -r "$HOME/.Xresources" ]; then
            xrdb -display "$xdisp.$xscr" -load "$HOME/.Xresources" 2>/dev/null
        elif [ -r "$HOME/.Sgiresources" ]; then
            xrdb -display "$xdisp.$xscr" -merge "$HOME/.Sgiresources" 2>/dev/null
        fi
        printf '%s\n' '*SG_UseBackgrounds: True' \
            "*freezeOnConfig: $freeze_on_config" |
            xrdb -display "$xdisp.$xscr" -merge 2>/dev/null || break
        xscr=$((xscr + 1))
    done
fi
IRIX_DEFINE_ROOT_POINTER_CURSOR=1 guest_exec "$wm" -launch $multiscreen \
    -xrm '*SG_UseBackgrounds: True' \
    -xrm "*freezeOnConfig: $freeze_on_config" &
wm_pid=$!

echo "IRIX session: waiting for 4Dwm"
wait_status=1
attempt=0
while [ "$attempt" -lt 40 ]; do
    if ! kill -0 "$wm_pid" 2>/dev/null; then
        wait "$wm_pid"
        wm_status=$?
        echo "IRIX session: 4Dwm exited during startup: $wm_status" >&2
        exit "$wm_status"
    fi

    guest_exec "$waitwm"
    wait_status=$?
    if [ "$wait_status" -eq 0 ]; then
        break
    fi

    attempt=$((attempt + 1))
    echo "IRIX session: 4Dwm not ready yet ($attempt/40)"
    sleep 0.5
done

if [ "$wait_status" -ne 0 ]; then
    echo "IRIX session: wait4wm timed out: $wait_status" >&2
    exit "$wait_status"
fi

echo "IRIX session: 4Dwm ready; starting Toolchest"
guest_exec "$toolchest" &
toolchest_pid=$!

# Traditional multihead: the Toolchest is the only way to launch things from
# the GUI, so give every further screen its own copy (and the per-screen
# icon/colour setup the first one got).
xdisp="${DISPLAY%.*}"
xscr=1
while [ "$xscr" -lt 8 ] && xdpyinfo -display "$xdisp.$xscr" >/dev/null 2>&1; do
    (
        DISPLAY="$xdisp.$xscr"; export DISPLAY
        guest_exec "$makeicons" >/dev/null 2>&1
        guest_exec "$prealloc" >/dev/null 2>&1
        exec "$root$toolchest"
    ) &
    xscr=$((xscr + 1))
done

echo "IRIX session: starting desktop File Manager"
guest_exec "$fm" -b &
fm_pid=$!

# Xsession.dt runs the user's startup-applications script once the desktop is
# up (output to the console there; the session log here).
sgisession="$HOME/.sgisession"
if [ -x "$sgisession" ]; then
    "$sgisession" &
elif [ -r "$sgisession" ]; then
    sh "$sgisession" &
fi

echo "IRIX session: running"

# Xsession.dt ends with "exec reaper".  reaper ignores SIGCLD, publishes
# _SGI_SESSION_PROPERTY on the root window and exits; SGI's xdm then keeps the
# login session alive until that property is removed, which 4Dwm does when it
# handles end_session (after saving its session) and endsession does if 4Dwm
# is gone.  Do the same here: publish the property and wait for it to vanish.
reaper="/usr/bin/X11/reaper"
session_property=_SGI_SESSION_PROPERTY
session_property_present()
{
    if command -v xprop >/dev/null 2>&1; then
        xprop -display "$display" -root "$session_property" 2>/dev/null
    else
        guest_exec /usr/bin/X11/xprop -display "$display" -root "$session_property" 2>/dev/null
    fi | grep -q "(ATOM)"
}

if [ -x "$root$reaper" ]; then
    guest_exec "$reaper"
    if session_property_present; then
        echo "IRIX session: reaper set $session_property; waiting for end_session"
        while kill -0 "$wm_pid" 2>/dev/null && session_property_present; do
            sleep 1
        done
        echo "IRIX session: $session_property cleared or 4Dwm gone; ending"
        # 4Dwm writes its session files before it clears the property; let it
        # finish and exit before the cleanup trap stops it.
        waited=0
        while kill -0 "$wm_pid" 2>/dev/null && [ "$waited" -lt 20 ]; do
            sleep 0.5
            waited=$((waited + 1))
        done
        exit 0
    fi
    echo "IRIX session: reaper did not publish $session_property; waiting on 4Dwm" >&2
fi

# Fallback: keep the session owner alive until the WM exits.
wait "$wm_pid"
status=$?
echo "IRIX session: 4Dwm exited: $status" >&2
exit "$status"
