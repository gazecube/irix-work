#!/bin/sh
set -u

default_root="@IRIX_RECOMP_ROOT@"
root="${IRIX_RECOMP_ROOT:-$default_root}"
runtime="@IRIX_RUNTIME_TREE@"
display="${DISPLAY:-:1}"

makeicons="/usr/lib/desktop/makeIconVisuals"
prealloc="/usr/lib/desktop/preallocColors"
wm="/usr/bin/X11/4Dwm"
waitwm="/usr/bin/X11/wait4wm"
toolchest="/usr/bin/X11/toolchest"
fm="/usr/sbin/fm"
default_guest_runner="@CMAKE_CURRENT_BINARY_DIR@/irix-guest-exec"
guest_runner="${IRIX_GUEST_EXEC_RUNNER:-$default_guest_runner}"

if [ ! -x "$guest_runner" ]; then
    echo "IRIX session: missing guest process runner: $guest_runner" >&2
    exit 1
fi
for p in "$makeicons" "$prealloc" "$wm" "$waitwm" "$toolchest" "$fm"; do
    if [ ! -r "$runtime$p" ]; then
        echo "IRIX session: missing guest image: $p" >&2
        exit 1
    fi
done
for guest_path in "$makeicons" "$prealloc" "$wm" "$waitwm" "$toolchest" "$fm"; do
    runner="$root$guest_path"
    if [ ! -x "$runner" ]; then
        echo "IRIX session: missing native x86-64 app runner: $runner" >&2
        exit 1
    fi
done

export DISPLAY="$display"
export IRIX_RECOMP_ROOT="$root"
export IRIX_GUEST_EXEC_RUNNER="$guest_runner"
# Keep session startup on the validated Xt/Motif path.  The runtime's legacy
# stability fallback defaults on, but it broadly repairs missing Xt/Xm state
# and can hide regressions; callers may still opt in explicitly.
export IRIX_XT_XM_STABILITY="${IRIX_XT_XM_STABILITY:-0}"
# Select the standard Unix-domain X transport inside original SGI libX11.
# DISPLAY remains the user's :N display on the host; only the guest process
# sees unix/:N, avoiding IRIX's /dev/xconnc shared-memory transport device.
case "$display" in
    :*) export IRIX_GUEST_DISPLAY="unix/$display" ;;
esac
guest_exec()
{
    guest_path=$1
    shift
    runner="$root$guest_path"
    "$runner" "$@"
}

cleanup()
{
    [ -n "${fm_pid:-}" ] && kill "$fm_pid" 2>/dev/null || true
    [ -n "${toolchest_pid:-}" ] && kill "$toolchest_pid" 2>/dev/null || true
    [ -n "${wm_pid:-}" ] && kill "$wm_pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

echo "IRIX session: preparing icon visuals"
guest_exec "$makeicons" || {
    status=$?
    echo "IRIX session: makeIconVisuals failed: $status" >&2
    exit "$status"
}

echo "IRIX session: preallocating colors"
guest_exec "$prealloc" || {
    status=$?
    echo "IRIX session: preallocColors failed: $status" >&2
    exit "$status"
}

echo "IRIX session: starting 4Dwm on $DISPLAY"
# SG_UseBackgrounds makes 4Dwm run bgInit, which publishes the
# _SGI_DESKS_BACKGROUND_DAEMON_WINDOW<root> selection used by the
# Background panel and xsetroot.
# The stock IRIX app-defaults ship *freezeOnConfig: false, which makes 4Dwm
# draw move/resize outlines with FlashOutline (draw, sync, erase, sync in a
# loop), so the outline blinks.  True grabs the server and uses the steady
# DrawOutline instead.  Set IRIX_4DWM_FREEZE_ON_CONFIG=false for the original
# blinking behaviour.
freeze_on_config="${IRIX_4DWM_FREEZE_ON_CONFIG:-true}"
IRIX_DEFINE_ROOT_POINTER_CURSOR=1 guest_exec "$wm" -launch \
    -xrm '*SG_UseBackgrounds: True' \
    -xrm "*freezeOnConfig: $freeze_on_config" &
wm_pid=$!

echo "IRIX session: waiting for 4Dwm"
wait_status=1
attempt=0
while [ "$attempt" -lt 40 ]; do
    if ! kill -0 "$wm_pid" 2>/dev/null; then
        wait "$wm_pid"
        wm_status=$?
        echo "IRIX session: 4Dwm exited during startup: $wm_status" >&2
        exit "$wm_status"
    fi

    guest_exec "$waitwm"
    wait_status=$?
    if [ "$wait_status" -eq 0 ]; then
        break
    fi

    attempt=$((attempt + 1))
    echo "IRIX session: 4Dwm not ready yet ($attempt/40)"
    sleep 0.5
done

if [ "$wait_status" -ne 0 ]; then
    echo "IRIX session: wait4wm timed out: $wait_status" >&2
    exit "$wait_status"
fi

echo "IRIX session: 4Dwm ready; starting Toolchest"
guest_exec "$toolchest" &
toolchest_pid=$!

echo "IRIX session: starting desktop File Manager"
guest_exec "$fm" -b &
fm_pid=$!

echo "IRIX session: running"

# Keep the session owner alive. If the WM exits, the session is over.
wait "$wm_pid"
status=$?
echo "IRIX session: 4Dwm exited: $status" >&2
exit "$status"
