#!/bin/sh
set -u

root="@IRIX_RECOMP_ROOT@"
runtime="@IRIX_RUNTIME_TREE@"
logdir="${TMPDIR:-/tmp}/irix-session"
display="${DISPLAY:-:1}"

mkdir -p "$logdir"

makeicons="$root/usr/lib/desktop/makeIconVisuals"
prealloc="$root/usr/lib/desktop/preallocColors"
wm="$root/usr/bin/X11/4Dwm"
waitwm="$root/usr/bin/X11/wait4wm"
toolchest="$root/usr/bin/X11/toolchest"
fm="$root/usr/sbin/fm"

for p in "$makeicons" "$prealloc" "$wm" "$waitwm" "$toolchest" "$fm"; do
    if [ ! -x "$p" ]; then
        echo "IRIX session: missing executable: $p" >&2
        exit 1
    fi
done

export DISPLAY="$display"
export IRIX_RECOMP_ROOT="$root"

cleanup()
{
    [ -n "${fm_pid:-}" ] && kill "$fm_pid" 2>/dev/null || true
    [ -n "${toolchest_pid:-}" ] && kill "$toolchest_pid" 2>/dev/null || true
    [ -n "${wm_pid:-}" ] && kill "$wm_pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

echo "IRIX session: preparing icon visuals"
IRIX_EXEC_BACKEND=interp "$makeicons" >"$logdir/makeIconVisuals.log" 2>&1 || {
    status=$?
    echo "IRIX session: makeIconVisuals failed: $status" >&2
    tail -80 "$logdir/makeIconVisuals.log" >&2 2>/dev/null || true
    exit "$status"
}

echo "IRIX session: preallocating colors"
IRIX_EXEC_BACKEND=interp "$prealloc" >"$logdir/preallocColors.log" 2>&1 || {
    status=$?
    echo "IRIX session: preallocColors failed: $status" >&2
    tail -80 "$logdir/preallocColors.log" >&2 2>/dev/null || true
    exit "$status"
}

echo "IRIX session: starting 4Dwm on $DISPLAY"
"$wm" -launch -xrm '*SG_UseBackgrounds: True' >"$logdir/4Dwm.log" 2>&1 &
wm_pid=$!

echo "IRIX session: waiting for 4Dwm"
wait_status=1
attempt=0
while [ "$attempt" -lt 40 ]; do
    if ! kill -0 "$wm_pid" 2>/dev/null; then
        wait "$wm_pid"
        wm_status=$?
        echo "IRIX session: 4Dwm exited during startup: $wm_status" >&2
        tail -120 "$logdir/4Dwm.log" >&2 2>/dev/null || true
        exit "$wm_status"
    fi

    "$waitwm" >"$logdir/wait4wm.log" 2>&1
    wait_status=$?
    if [ "$wait_status" -eq 0 ]; then
        break
    fi

    attempt=$((attempt + 1))
    echo "IRIX session: 4Dwm not ready yet ($attempt/40)"
    sleep 0.5
done

if [ "$wait_status" -ne 0 ]; then
    echo "IRIX session: wait4wm timed out: $wait_status" >&2
    tail -120 "$logdir/4Dwm.log" >&2 2>/dev/null || true
    tail -120 "$logdir/wait4wm.log" >&2 2>/dev/null || true
    exit "$wait_status"
fi

echo "IRIX session: 4Dwm ready; starting Toolchest"
"$toolchest" -name ToolChest >"$logdir/toolchest.log" 2>&1 &
toolchest_pid=$!

echo "IRIX session: starting desktop File Manager"
"$fm" -b >"$logdir/fm.log" 2>&1 &
fm_pid=$!

echo "IRIX session: running"
echo "IRIX session logs: $logdir"

# Keep the session owner alive. If the WM exits, the session is over.
wait "$wm_pid"
status=$?
echo "IRIX session: 4Dwm exited: $status" >&2
exit "$status"
