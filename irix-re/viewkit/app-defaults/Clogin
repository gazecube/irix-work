! Probe-safe subset of the preserved IRIX Clogin app-defaults.
! Derived from irix-re/clogin/evidence/Clogin.app-defaults.
! The original file begins with an IRIX-specific absolute #include of
! /usr/lib/X11/app-defaults/SetPassComp; that include is intentionally omitted
! here so Linux Xt can consume this file directly through XFILESEARCHPATH.

Clogin*useSchemes: all
Clogin*schemeFileList: SgiSpec, ImdSpec
Clogin*paletteFileList: ImdPalette
Clogin*sgiMode: True
Clogin*arrowsType: XmNO_THUMB_WHEN_EMPTY
Clogin*frame.shadowThickness: 0
Clogin*panelWindow.shadowThickness: 0
Clogin*form.XmText.blinkRate: 0

*useNoHang: True
*ImdViewPanel.invertedTeeMargin: 3
*ImdViewPanel.noDragNDrop: True
*panel.traversalOn: False
*helpButton.traversalOn: False
*loginButton.traversalOn: False
*scrolledWindow*traversalOn: False
*Xdraw.traversalOn: False

