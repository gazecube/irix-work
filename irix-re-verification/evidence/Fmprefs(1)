!
! Resource defaults for the Indigo Magic Desktop application 
! /usr/sbin/fmprefs, the Default Layout for Icon Views panel
!

!
! Activate schemes and SGI mode by default
!
Fmprefs*useSchemes: all
Fmprefs*sgiMode: True
Fmprefs*schemeFileList: SgiSpec, ImdSpec

! for the QuickHelp line at the bottom of the panel
Fmprefs*showHelp:              True
Fmprefs*showPopupHelp:         False
Fmprefs*showMsgLineHelp:       True
! this needs to be blank (empty string) for default messages
Fmprefs*msgLineHelpText:
! 500382
Fmprefs*VkQuickHelpMsgLine.height: 

!
! SGI Style guide specifies explicit focus within applications
!
Fmprefs*keyboardFocusPolicy: explicit

! name of iconified window
