#include "/usr/lib/X11/app-defaults/SetPassComp"

! Clogin resources

Clogin*useSchemes: all
Clogin*schemeFileList: SgiSpec, ImdSpec
Clogin*paletteFileList: ImdPalette
Clogin*sgiMode: True
Clogin*arrowsType: XmNO_THUMB_WHEN_EMPTY
Clogin*frame.shadowThickness:0
Clogin*panelWindow.shadowThickness: 0
Clogin*form.XmText.blinkRate: 0

!
! By default, clogin does not hang on down nfs mounts, which makes
! clogin accessible even when its face server is down.  If this is
! causing problems in your environment, change the setting of
! the "useNoHang" resource to "False".
*useNoHang: True

*ImdViewPanel.invertedTeeMargin: 3
*ImdViewPanel.noDragNDrop: True
*panel.traversalOn: False
*helpButton.traversalOn: False
*loginButton.traversalOn: False
*scrolledWindow*traversalOn: False
*Xdraw.traversalOn: False

# error messages

### The following two messages use the same wording for security reasons:
#   they make it more difficult to hunt for valid accounts, since they
#   don't distinguish between entering the wrong password for a valid account
#   and entering an invalid account (user name).
#   They may be changed to the messages below if this is not a concern at
#   your location.
Clogin*intl.err_pwdIncorrect: Cannot log in to this account.
Clogin*intl.err_badUser: Cannot log in to this account.
### Clogin*intl.err_pwdIncorrect: The password you entered is not correct. \n Cannot log in to this account.
### Clogin*intl.err_badUser: There is no account that matches the login name \n that you entered. Cannot log in to this account.

Clogin*intl.msg_howToLogin: To log in, type your login name and click Log in,\nor double-click the icon that's labeled with your login name.
Clogin*intl.err_noHomeDir: The home directory for this account does not exist.
Clogin*intl.err_loginRestricted: Login is restricted for this account.
Clogin*intl.err_loginInactive: This account's inactive period expired. Cannot login.
Clogin*intl.err_pwdChangeFailed: The password change failed.
Clogin*intl.msg_newPwd: Your workstation requires every account to have a password.
Clogin*intl.msg_agedPwd: Your password has expired(aged). You need a new password.
Clogin*intl.msg_passwdhelp: Enter the new password in the first text fields.\nEnter the same password again in the second text field\nfor verifications. This new password should be used\nnext time when you login to this account.
Clogin*intl.msg_help: If this is a new system and you do not yet have a\npersonal work area, use the left mouse button to\ndouble-click the EZsetup icon; this logs you into\nthe system so you can set up basic system\ninformation.\n\nTo log in to your personal work area on the system,\nfollow these steps:\n\n1. Find the icon that is labeled with your login\n    name, then double-click the icon; if your\n    account has no password, the system logs you\n    in.\n\n    If an icon for your account doesn't appear in the\n    login window, type your login name in the field\n    and press <Enter>.\n\n2. If a Password field appears, enter the password,\n   then click the Login button.

! Display this rgb file when noiconlogin is on
Clogin*intl.logoPath: /usr/Cadmin/images/cloginlogo.rgb

!! No current slot in font palette for the following
Clogin*userFullNameLabel.fontList: -adobe-helvetica-medium-o-normal--*-240-75-75-p-*-iso8859-1

Clogin*warningLabel.fontList: 	SGI_DYNAMIC ExtraLargeBoldLabelFont
Clogin*userLabel.fontList: 	SGI_DYNAMIC ExtraLargeBoldLabelFont
Clogin*passwordLabel.fontList: 	SGI_DYNAMIC ExtraLargeBoldLabelFont
Clogin*hostLabel.fontList: 	SGI_DYNAMIC ExtraLargeBoldLabelFont
!! No current slot in font palette for the following
Clogin*hostLabel.fontList: -adobe-helvetica-bold-o-normal--*-240-100-100-p-*-iso8859-1
	

!! No current slot in font palette for the following
Clogin*userText.fontList: -adobe-helvetica-medium-r-normal-*-17-*-*-*-*-*-iso8859-1
Clogin*passwordText.fontList: -adobe-helvetica-medium-r-normal-*-17-*-*-*-*-*-iso8859-1
Clogin*helpButton.fontList:-adobe-helvetica-medium-r-normal-*-17-*-*-*-*-*-iso8859-1
Clogin*loginButton.fontList:	-adobe-helvetica-medium-r-normal-*-17-*-*-*-*-*-iso8859-1


