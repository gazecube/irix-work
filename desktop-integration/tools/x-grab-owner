#!/bin/sh
# x-grab-owner [--release]
#
# Name the X client that holds the active pointer grab (the "input is dead,
# clicks go nowhere" state) and, with --release, ask that process to ungrab.
#
# Reads the grab record from the running Xorg with gdb (read-only attach), so
# it needs the Xorg dev headers (offsets are computed from them) and ptrace
# permission (run as root, or sudo).  The release step runs
# XUngrabPointer/XUngrabKeyboard inside the owning process, and only works for
# the recompiled IRIX runners (they expose g_x11).  Anything else: close it.
set -eu
disp="${DISPLAY:-:0}"
xpid=$(pgrep -x Xorg | head -1)
[ -n "$xpid" ] || { echo "no Xorg process" >&2; exit 1; }
cc=${CC:-cc}
tmp=$(mktemp -d)
cat >"$tmp/o.c" <<'C'
#include <xorg-server.h>
#include <stddef.h>
#include <stdio.h>
#include <X11/X.h>
#include "inputstr.h"
#include "dixgrabs.h"
int main(void){
  printf("%zu %zu %zu %zu %zu\n", offsetof(InputInfo, pointer),
         offsetof(DeviceIntRec, deviceGrab) + offsetof(GrabInfoRec, grab),
         offsetof(GrabRec, resource), offsetof(GrabRec, window),
         offsetof(GrabRec, grabtype));
  return 0; }
C
$cc -I/usr/include/xorg -I/usr/include/pixman-1 -o "$tmp/o" "$tmp/o.c" 2>/dev/null \
    || { echo "need xorg-server headers (xorg-server-devel)" >&2; exit 1; }
set -- $("$tmp/o") "${1:-}"
po=$1 go=$2 ro=$3 wo=$4; rel=${6:-}
out=$(gdb -p "$xpid" -batch \
  -ex "set \$ptr = *(void**)((char*)&inputInfo + $po)" \
  -ex "set \$grab = *(void**)((char*)\$ptr + $go)" \
  -ex 'printf "GRAB %p\n", $grab' \
  -ex "printf \"RES 0x%x\n\", *(unsigned int*)((char*)\$grab + $ro)" 2>&1 || true)
grab=$(echo "$out" | sed -n 's/^GRAB //p')
if [ -z "$grab" ] || [ "$grab" = "(nil)" ] || [ "$grab" = "0x0" ]; then
    echo "no active pointer grab"; rm -rf "$tmp"; exit 0
fi
res=$(echo "$out" | sed -n 's/^RES //p')
base=$(( res & ~0x1fffff ))
echo "pointer grab held by X client base $(printf 0x%x $base) (resource $res)"
pid=$(DISPLAY=$disp python3 - "$base" <<'P'
import sys
from Xlib import display
d=display.Display()
r=d.res_query_client_ids([{'client':int(sys.argv[1]),'mask':2}])
print(' '.join(str(v) for i in r.ids for v in i.value))
P
)
for p in $pid; do
    echo "  -> pid $p: $(ps -o args= -p "$p" | cut -c1-100)"
done
if [ "${1:-}" = "--release" ] || [ "$rel" = "--release" ]; then
    for p in $pid; do
        d1=$(gdb -p "$p" -batch -ex 'set $d = *(void**)((char*)&g_x11 + 8)' \
              -ex 'p (char*)XDisplayString($d)' 2>&1 | grep -c '":0"\|":1"' || true)
        [ "$d1" -gt 0 ] || { echo "  pid $p: not an IRIX runner (no g_x11); close it instead"; continue; }
        gdb -p "$p" -batch -ex 'set $d = *(void**)((char*)&g_x11 + 8)' \
            -ex 'p (int)XUngrabPointer($d, 0)' -ex 'p (int)XUngrabKeyboard($d, 0)' \
            -ex 'p (int)XFlush($d)' >/dev/null 2>&1
        echo "  pid $p: ungrab requested"
    done
fi
rm -rf "$tmp"
