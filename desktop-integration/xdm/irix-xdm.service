# IRIX xdm (original binary, Clogin greeter) as the display manager.
# Not enabled by default: start it from a TTY, with Ly kept as the fallback.
#   sudo systemctl stop ly@tty2 && sudo systemctl start irix-xdm
#   (back:) sudo systemctl stop irix-xdm && sudo systemctl start ly@tty2
[Unit]
Description=IRIX xdm display manager (Clogin)
After=systemd-user-sessions.service systemd-logind.service
Conflicts=ly@tty2.service
After=ly@tty2.service

[Service]
Type=simple
Environment=IRIX_RUNTIME_TREE=/home/nekron/Projects/irix-work/IRIX-TREE
ExecStartPre=-/usr/bin/rm -f /home/nekron/Projects/irix-work/IRIX-TREE/var/X11/xdm/xdm-pid
ExecStart=/home/nekron/Projects/irix-work/build-irix-re/recomp/root/usr/bin/X11/xdm -nodaemon -config /var/X11/xdm/xdm-config.real
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
Alias=display-manager.service
