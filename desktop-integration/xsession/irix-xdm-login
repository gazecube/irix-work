#!/bin/sh
# loginProgram for the original IRIX xdm: run the recompiled Clogin greeter.
# xdm starts this through the host shell (its system() is not tree-relative),
# so it cannot be the stock /var/X11/xdm/Xlogin script, which names guest
# paths.  It does what that script ends in: `clogin -f $DISPLAY`.
here="$(cd "$(dirname "$0")" && pwd)"
R="${IRIX_WORK:-$(cd "$here/../.." && pwd)}"
BUILD="${IRIX_BUILD:-build-irix-re}"
# xdm runs the login program as `<program> -g` with DISPLAY in the environment;
# the stock Xlogin ends in `clogin -f $1`, i.e. clogin -f -g.
d="$DISPLAY"
export IRIX_GUEST_DISPLAY="$d"
export IRIX_RUNTIME_TREE="${IRIX_RUNTIME_TREE:-$R/IRIX-TREE}"
if [ -n "$IRIX_XDM_LOGIN_LOG" ]; then
    # Debug: keep what the greeter tells xdm (username, environment).
    "$R/$BUILD/recomp/root/usr/Cadmin/bin/clogin" -f "$@" \
        2>>"$IRIX_XDM_LOGIN_LOG.err" | tee -a "$IRIX_XDM_LOGIN_LOG"
    exit 0
fi
exec "$R/$BUILD/recomp/root/usr/Cadmin/bin/clogin" -f "$@"
